# PostgreSQL
POSTGRES_IMAGE=pgvector/pgvector:pg16
POSTGRES_CONTAINER_NAME=chunk-norris-db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=app_db
POSTGRES_PORT=5432
POSTGRES_DATA_PATH=./data/postgres
POSTGRES_INITDB_ARGS=--data-checksums --auth-host=scram-sha-256
POSTGRES_SHM_SIZE=1gb
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB

# MinIO S3 Object Storage
MINIO_IMAGE=cgr.dev/chainguard/minio:latest
MINIO_CONTAINER_NAME=chunk-norris-minio
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_secure_minio_password_here
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DATA_PATH=./data/minio
S3_ENDPOINT=http://localhost:9000

# Backend Application
BACKEND_CONTAINER_NAME=chunk-norris-backend
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/app_db
